{
  "cleanUrls": true,
  "functions": {
    "api/halo.js": { "maxDuration": 60, "memory": 1024 }
  },
  "crons": [
    { "path": "/api/tick", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/m/:id", "destination": "/api/halo?op=meta&id=:id" },
    { "source": "/i/:id", "destination": "/api/halo?op=img&id=:id" },
    { "source": "/api/:op(status|pow|launch|launches|coins|claim|claimbuild|claimsend|withdrawbuild|withdrawsend|dryrun|tick)", "destination": "/api/halo?op=:op" }
  ],
  "headers": [
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] },
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
